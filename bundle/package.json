{
  "name": "@anima/bundle",
  "description": "Installs the Anima plugins into a DSH profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.yml": "./presets/*.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "presets",
    "locale"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/waking.patch.yml",
        "./presets/consolidation.patch.yml",
        "./presets/viewing.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@anima/adapter-bili": "workspace:*",
    "@anima/adapter-qq": "workspace:*",
    "@anima/core": "workspace:*",
    "@anima/life": "workspace:*",
    "@anima/memory": "workspace:*"
  }
}
