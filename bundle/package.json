{
  "name": "@anima/bundle",
  "description": "Installs the Anima plugins into a DSH profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["cordis.patch.yml", "locale"],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@anima/core": "workspace:*"
  }
}
